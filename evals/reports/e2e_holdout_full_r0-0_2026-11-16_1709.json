  "status": "done",
  "cost": 0.02126,
  "attempts": 1,
  "sql": "SELECT\n  s.device AS device,\n  SUM(CASE WHEN s.cancelled_at IS NULL THEN s.net_amount ELSE 0 END) / NULLIF(COUNT(DISTINCT CASE WHEN s.cancelled_at IS NULL THEN s.order_id END), 0) AS aov,\n  COUNT(DISTINCT CASE WHEN s.cancelled_at IS NULL THEN s.order_id END) AS qualifying_orders\nFROM sales AS s\nWHERE\n  s.line_type = 'Sale'\n  AND s.placed_at >= CAST('2026-01-01' AS TIMESTAMP)\n  AND s.placed_at < CAST('2026-11-15' AS TIMESTAMP)\nGROUP BY\n  s.device\nORDER BY\n  aov DESC\nLIMIT 50",
