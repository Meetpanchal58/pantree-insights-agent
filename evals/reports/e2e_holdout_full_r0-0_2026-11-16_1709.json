  "question": "What is the return rate for each apparel sub-category?",
  "seconds": 30.9,
  "status": "done",
  "cost": 0.02557,
  "attempts": 1,
  "sql": "SELECT\n  p.sub_category,\n  COUNT(*) FILTER(WHERE\n    NOT s.return_requested_at IS NULL) / NULLIF(COUNT(*) FILTER(WHERE\n    NOT s.delivered_at IS NULL), 0) AS return_rate,\n  COUNT(*) FILTER(WHERE\n    NOT s.return_requested_at IS NULL) AS returned_lines,\n  COUNT(*) FILTER(WHERE\n    NOT s.delivered_at IS NULL) AS delivered_lines\nFROM sales AS s\nJOIN product_master AS p\n  ON s.product_id = p.product_id\nWHERE\n  s.line_type = 'Sale'\n  AND p.category = 'Apparel'\n  AND s.placed_at >= CAST('2025-01-01' AS TIMESTAMP)\n  AND s.placed_at < CAST('2026-11-15' AS TIMESTAMP)\nGROUP BY\n  p.sub_category\nORDER BY\n  return_rate DESC",
