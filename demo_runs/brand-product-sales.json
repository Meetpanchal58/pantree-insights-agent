    {
      "type": "step",
      "step": "execute",
      "status": "done",
      "detail": {
        "sql": "WITH lines AS (\n  SELECT\n    p.brand_name,\n    p.category,\n    p.product_id,\n    p.product_name,\n    s.order_id,\n    CASE\n      WHEN NOT s.delivered_at IS NULL\n      THEN s.net_amount - COALESCE(s.refund_amount, 0)\n      ELSE 0\n    END AS revenue\n  FROM sales AS s\n  JOIN product_master AS p\n    ON p.product_id = s.product_id\n  WHERE\n    s.line_type = 'Sale'\n    AND s.placed_at >= CAST('2026-01-01' AS TIMESTAMP)\n    AND s.placed_at < CAST('2026-11-14' AS DATE) + INTERVAL '1' DAY\n), brand_totals AS (\n  SELECT\n    brand_name,\n    SUM(revenue) AS realized_revenue,\n    COUNT(DISTINCT order_id) AS orders\n  FROM lines\n  GROUP BY\n    brand_name\n), top_brands AS (\n  SELECT\n    brand_name,\n    realized_revenue,\n    orders,\n    ROW_NUMBER() OVER (ORDER BY realized_revenue DESC, brand_name) AS position\n  FROM brand_totals\n  QUALIFY\n    position <= 5\n), product_totals AS (\n  SELECT\n    l.brand_name,\n    l.category,\n    l.product_id,\n    l.product_name,\n    SUM(l.revenue) AS realized_revenue,\n    COUNT(DISTINCT l.order_id) AS orders\n  FROM lines AS l\n  JOIN top_brands AS b\n    USING (brand_name)\n  GROUP BY\n    l.brand_name,\n    l.category,\n    l.product_id,\n    l.product_name\n), product_ranks AS (\n  SELECT\n    brand_name,\n    category,\n    product_id,\n    product_name,\n    realized_revenue,\n    orders,\n    ROW_NUMBER() OVER (PARTITION BY brand_name, category ORDER BY realized_revenue DESC, product_id) AS position\n  FROM product_totals\n)\nSELECT\n  b.position AS brand_rank,\n  b.brand_name,\n  b.realized_revenue AS brand_revenue,\n  b.orders AS brand_orders,\n  p.category,\n  p.position AS product_rank,\n  p.product_id,\n  p.product_name,\n  p.realized_revenue AS product_revenue,\n  p.orders AS product_orders,\n  (\n    SELECT\n      SUM(revenue)\n    FROM lines\n  ) AS total_revenue\nFROM top_brands AS b\nJOIN product_ranks AS p\n  USING (brand_name)\nWHERE\n  p.position <= 5\nORDER BY\n  brand_rank,\n  p.category,\n  product_rank",
