   "sql": "WITH cohort AS (\n  SELECT\n    p.category,\n    p.sub_category,\n    p.article_type,\n    s.size_fit,\n    s.return_reason,\n    s.delivered_at,\n    s.return_requested_at\n  FROM sales AS s\n  LEFT JOIN product_master AS p\n    ON p.product_id = s.product_id\n  WHERE\n    s.line_type = 'Sale'\n    AND s.placed_at >= CAST('2026-01-01' AS TIMESTAMP)\n    AND s.placed_at < CAST('2026-10-25' AS TIMESTAMP)\n)\nSELECT\n  breakdown,\n  category,\n  sub_category,\n  article_type,\n  size_fit,\n  return_reason,\n  return_rate,\n  delivered_lines,\n  return_requested_lines\nFROM (\n  (\n    SELECT\n      'category' AS breakdown,\n      COALESCE(s.category, '(missing)') AS category,\n      NULL AS sub_category,\n      NULL AS article_type,\n      NULL AS size_fit,\n      NULL AS return_reason,\n      COUNT(*) FILTER(WHERE\n        NOT s.return_requested_at IS NULL) / NULLIF(COUNT(*) FILTER(WHERE\n        NOT s.delivered_at IS NULL), 0) AS return_rate,\n      COUNT(*) FILTER(WHERE\n        NOT s.delivered_at IS NULL) AS delivered_lines,\n      COUNT(*) FILTER(WHERE\n        NOT s.return_requested_at IS NULL) AS return_requested_lines\n    FROM cohort AS s\n    GROUP BY\n      COALESCE(s.category, '(missing)')\n    ORDER BY\n      return_requested_lines DESC,\n      category\n    LIMIT 50\n  )\n  UNION ALL\n  (\n    SELECT\n      'footwear_segment',\n      'Footwear',\n      COALESCE(s.sub_category, '(missing)'),\n      COALESCE(s.article_type, '(missing)'),\n      NULL,\n      NULL,\n      COUNT(*) FILTER(WHERE\n        NOT s.return_requested_at IS NULL) / NULLIF(COUNT(*) FILTER(WHERE\n        NOT s.delivered_at IS NULL), 0),\n      COUNT(*) FILTER(WHERE\n        NOT s.delivered_at IS NULL),\n      COUNT(*) FILTER(WHERE\n        NOT s.return_requested_at IS NULL) AS return_requested_lines\n    FROM cohort AS s\n    WHERE\n      s.category = 'Footwear'\n    GROUP BY\n      COALESCE(s.sub_category, '(missing)'),\n      COALESCE(s.article_type, '(missing)')\n    ORDER BY\n      return_requested_lines DESC,\n      3,\n      4\n    LIMIT 50\n  )\n  UNION ALL\n  (\n    SELECT\n      'footwear_size_fit',\n      'Footwear',\n      NULL,\n      NULL,\n      COALESCE(s.size_fit, '(missing)'),\n      NULL,\n      COUNT(*) FILTER(WHERE\n        NOT s.return_requested_at IS NULL) / NULLIF(COUNT(*) FILTER(WHERE\n        NOT s.delivered_at IS NULL), 0),\n      COUNT(*) FILTER(WHERE\n        NOT s.delivered_at IS NULL),\n      COUNT(*) FILTER(WHERE\n        NOT s.return_requested_at IS NULL) AS return_requested_lines\n    FROM cohort AS s\n    WHERE\n      s.category = 'Footwear'\n    GROUP BY\n      COALESCE(s.size_fit, '(missing)')\n    ORDER BY\n      return_requested_lines DESC,\n      5\n    LIMIT 50\n  )\n  UNION ALL\n  (\n    SELECT\n      'footwear_return_reason',\n      'Footwear',\n      NULL,\n      NULL,\n      NULL,\n      COALESCE(s.return_reason, '(missing)'),\n      NULL,\n      NULL,\n      COUNT(*) AS return_requested_lines\n    FROM cohort AS s\n    WHERE\n      s.category = 'Footwear' AND NOT s.return_requested_at IS NULL\n    GROUP BY\n      COALESCE(s.return_reason, '(missing)')\n    ORDER BY\n      return_requested_lines DESC,\n      6\n    LIMIT 50\n  )\n) AS results\nORDER BY\n  CASE breakdown\n    WHEN 'category'\n    THEN 1\n    WHEN 'footwear_segment'\n    THEN 2\n    WHEN 'footwear_size_fit'\n    THEN 3\n    ELSE 4\n  END,\n  return_requested_lines DESC,\n  category,\n  sub_category,\n  article_type,\n  size_fit,\n  return_reason",
