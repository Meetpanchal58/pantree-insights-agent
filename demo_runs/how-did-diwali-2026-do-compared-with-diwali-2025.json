   "sql": "WITH event_totals AS (\n  SELECT\n    e.event_id,\n    e.name AS event_name,\n    e.start_date,\n    e.end_date,\n    DATE_DIFF('DAY', CAST(e.start_date AS DATE), CAST(e.end_date AS DATE)) + 1 AS event_days,\n    COUNT(DISTINCT s.order_id) AS orders,\n    COALESCE(\n      SUM(\n        CASE\n          WHEN NOT s.delivered_at IS NULL\n          THEN s.net_amount - COALESCE(s.refund_amount, 0)\n          ELSE 0\n        END\n      ),\n      0\n    ) AS realized_revenue,\n    COALESCE(SUM(CASE WHEN s.cancelled_at IS NULL THEN s.net_amount ELSE 0 END), 0) AS net_sales\n  FROM sale_events AS e\n  LEFT JOIN sales AS s\n    ON s.placed_at >= CAST(CAST(e.start_date AS DATE) AS TIMESTAMP)\n    AND s.placed_at < CAST(CAST(e.end_date AS DATE) AS TIMESTAMP) + INTERVAL '1' DAY\n    AND s.placed_at >= CAST('2025-01-01' AS TIMESTAMP)\n    AND s.placed_at < CAST('2026-11-15' AS TIMESTAMP)\n    AND s.line_type = 'Sale'\n  WHERE\n    e.name IN ('Diwali 2025', 'Diwali 2026')\n  GROUP BY\n    e.event_id,\n    e.name,\n    e.start_date,\n    e.end_date\n)\nSELECT\n  event_name,\n  start_date,\n  end_date,\n  event_days,\n  orders,\n  realized_revenue,\n  net_sales,\n  orders * 1.0 / NULLIF(event_days, 0) AS orders_per_day,\n  realized_revenue / NULLIF(event_days, 0) AS realized_revenue_per_day,\n  net_sales / NULLIF(event_days, 0) AS net_sales_per_day\nFROM event_totals\nORDER BY\n  start_date",
