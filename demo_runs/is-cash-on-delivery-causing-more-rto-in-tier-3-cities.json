   "question": "Is cash on delivery causing more RTO in tier 3 cities?",
   "plan": {
    "decision": "proceed",
    "decline_reason": null,
    "clarifying_questions": [],
    "restated_question": "Among orders placed for delivery to Tier 3 addresses, is the RTO rate higher for COD than prepaid payments?",
    "metrics": [
     "rto_rate",
     "Shipped lines: count of sale lines with shipped_at IS NOT NULL",
     "RTO lines: count of sale lines with rto_at IS NOT NULL"
    ],
    "breakdowns": [
     "Payment type: COD when payment_method = 'COD'; otherwise prepaid"
    ],
    "filters": [
     "sales.line_type = 'Sale'",
     "customer_addresses.city_tier = 'Tier 3'"
    ],
    "time_window": "2025-01-01 to 2026-10-24 inclusive, by sales.placed_at",
    "comparison": "COD versus prepaid within Tier 3 delivery addresses",
    "output_shape": "One row per payment type, with RTO rate, shipped lines and RTO lines.",
    "assumptions": [
     "Use the delivery address tier linked through sales.address_id.",
     "Exclude the last three weeks of orders to reduce RTO reporting lag; some earlier outcomes may still be incomplete.",
     "Following the verified payment-type definition, all non-COD methods are grouped as prepaid.",
     "An observed difference indicates association, not proof that COD causes RTO."
    ]
   },
   "sql": "SELECT\n  CASE WHEN s.payment_method = 'COD' THEN 'COD' ELSE 'Prepaid' END AS payment_type,\n  (\n    COUNT(*) FILTER(WHERE\n      NOT s.rto_at IS NULL)\n  ) / NULLIF(COUNT(*) FILTER(WHERE\n    NOT s.shipped_at IS NULL), 0) AS rto_rate,\n  COUNT(*) FILTER(WHERE\n    NOT s.shipped_at IS NULL) AS shipped_lines,\n  COUNT(*) FILTER(WHERE\n    NOT s.rto_at IS NULL) AS rto_lines\nFROM sales AS s\nJOIN customer_addresses AS a\n  ON s.address_id = a.address_id\nWHERE\n  s.line_type = 'Sale'\n  AND a.city_tier = 'Tier 3'\n  AND s.placed_at >= CAST('2025-01-01' AS TIMESTAMP)\n  AND s.placed_at < CAST('2026-10-04' AS TIMESTAMP)\nGROUP BY\n  1\nORDER BY\n  rto_rate DESC",
