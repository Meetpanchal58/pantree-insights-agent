   "sql": "WITH spend AS (\n  SELECT\n    c.channel,\n    SUM(m.spend) AS marketing_spend\n  FROM marketing_spend AS m\n  JOIN campaigns AS c\n    ON c.campaign_id = m.campaign_id\n  WHERE\n    m.date_hour >= CAST('2026-01-01' AS TIMESTAMP)\n    AND m.date_hour < CAST('2026-11-15' AS TIMESTAMP)\n  GROUP BY\n    c.channel\n), attribution AS (\n  SELECT\n    c.channel,\n    SUM(a.credit_last_click) AS credited_orders,\n    SUM(a.credit_last_click * a.order_revenue) AS attributed_revenue\n  FROM marketing_attribution AS a\n  JOIN campaigns AS c\n    ON c.campaign_id = a.campaign_id\n  WHERE\n    a.order_at >= CAST('2026-01-01' AS TIMESTAMP)\n    AND a.order_at < CAST('2026-11-15' AS TIMESTAMP)\n  GROUP BY\n    c.channel\n)\nSELECT\n  s.channel,\n  s.marketing_spend,\n  COALESCE(a.credited_orders, 0) AS credited_orders,\n  COALESCE(a.attributed_revenue, 0) AS attributed_revenue,\n  COALESCE(a.attributed_revenue, 0) / NULLIF(s.marketing_spend, 0) AS last_click_roas\nFROM spend AS s\nLEFT JOIN attribution AS a\n  ON s.channel IS NOT DISTINCT FROM a.channel\nORDER BY\n  last_click_roas DESC,\n  s.channel\nLIMIT 50",
