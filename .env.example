# Copy to .env (never commit .env).

# Data: the simulator shop size to use (small | full | large) and where it is downloaded
DATA_SIZE=full
# DATA_DIR=./data

# Query limits
MAX_ROWS=500
QUERY_TIMEOUT_S=30

# LLM: "provider:model" (LangChain init_chat_model). Prices are in config.py.
OPENAI_API_KEY=
MODEL_MAIN=openai:gpt-6.1-terra
MODEL_LIGHT=openai:gpt-6-luna
REASONING_EFFORT=low
DAILY_BUDGET_USD=1.00
MAX_PARALLEL_LLM_CALLS=2
MAX_CONCURRENT_RUNS=4            # questions processed at once; the rest queue visibly
CONTRAST_CHECK=true              # run alternative readings; ask when their numbers differ

# Web app (pantree-web)
APP_ENV=development              # production: secure cookies, SESSION_SECRET required
PUBLIC_URL=http://127.0.0.1:8000
SESSION_SECRET=                  # long random string in production
DATABASE_URL=                    # empty = SQLite in .cache/app.db; production: Neon Postgres URL
CHECKPOINT_BACKEND=memory       # Cloud Run uses postgres for durable paused clarifications
ADMIN_EMAILS=["you@example.com"] # may share insights into everyone's business memory
DAILY_QUESTION_LIMIT=10

# Sign-in with Google (OAuth client in Google Cloud; redirect URI: <PUBLIC_URL>/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in with an emailed code (e.g. Gmail app password). In development without SMTP, codes are printed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
