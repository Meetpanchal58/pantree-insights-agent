# Copy to .env (never commit .env).

# Data: the simulator shop size to use (small | full | large) and where it is downloaded
DATA_SIZE=full
# DATA_DIR=./data

# Query limits
MAX_ROWS=500
QUERY_TIMEOUT_S=30

# LLM: "provider:model" (LangChain init_chat_model). Prices are in config.py.
OPENAI_API_KEY=
MODEL_MAIN=openai:gpt-6.1-terra
MODEL_LIGHT=openai:gpt-6-luna
REASONING_EFFORT=low
SQL_REASONING_EFFORT=medium
DAILY_BUDGET_USD=1.00
